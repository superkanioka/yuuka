# ==============================================================================
# Yuuka 開発(dev) インスタンス設定 — Docker 運用版（テンプレート）
#   cp config.yaml.example config.yaml して編集する。config.yaml は .gitignore 済。
#   本番とは別の Discord Bot Token / 別の暗号化シークレット / 別データで動かす隔離環境。
# ==============================================================================

# DB（/app/data はホストの deploy/dev/data を bind マウント＝空から新規作成）
DB_PATH: "./data/yuuka.db"

# dev 専用 Redis コンテナへ接続
REDIS_URL: "redis://redis:6379"

REMINDER_CRON: "* * * * *"

# 管理画面（コンテナ内待受は固定。ホスト公開は instance.env の HOST_PORT=7855）
PORT: 7854
HOST: "0.0.0.0"

# dev 専用の招待コード
INVITE_CODES:
  - "yuuka-dev-001"
  - "yuuka-dev-002"

# Google OAuth2（dev は http://localhost のため既定で無効。必要時に dev 用クライアントを設定）
GOOGLE_CLIENT_ID: ""
GOOGLE_CLIENT_SECRET: ""

# 外部公開ベースURL（dev はローカルのみ＝ホスト 7855。http:// のため Cookie は非Secure発行）
BASE_URL: "http://localhost:7855"

PRIVACY_POLICY_URL: "/privacy"
TERMS_URL: "/terms"
GOOGLE_SITE_VERIFICATION: ""

# ==============================================================================
# Instagram 連携（§3.15・任意）
# ==============================================================================
# 自分のInstagram新規投稿をDiscordチャンネルへ自動転送します。
# Docker 運用では compose の環境変数 pass-through が固定リストのため、トークンを含め
# **すべてこの config.yaml に書く**（本ファイルは .gitignore 済み・:ro マウント）。
#
# 前提: Instagramアカウントを Business/Creator に切り替え、Meta for Developers でアプリを作成し
# instagram_business_basic スコープで認可しておくこと（Facebookページ連携は不要）。
# 本機能は Rust 実装のみ（Node イメージでは動作しません）。

# 転送先DiscordチャンネルID。空欄なら連携サービスは登録されません。
# INSTAGRAM_CHANNEL_ID: ""

# チャンネル露出ガードの検証対象＝オーナーのDiscordユーザーID。
# 未設定なら ADMIN_DISCORD_IDS の先頭を使います。このユーザーが転送先チャンネルの
# ギルドに在籍していないとDMへフォールバックします。
# INSTAGRAM_OWNER_DISCORD_ID: ""

# 初回連携用アクセストークン（短期可）。起動時に長期トークン（60日）へ交換し、
# instagram_account テーブルへ暗号化保存します。以降はDB側が正のため削除して構いません。
# INSTAGRAM_ACCESS_TOKEN: ""

# アプリシークレット。短期→長期トークンの交換に必要です。
# INSTAGRAM_APP_SECRET: ""

# ポーリング間隔（cron式、既定 */20 * * * *）。
# Instagram APIのレート制限（1時間200コール/ユーザー）に収まる範囲で設定します。
# INSTAGRAM_POLL_CRON: "*/20 * * * *"
