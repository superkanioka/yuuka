# yuuka のセッション用 Redis（システム systemd・User= で一般ユーザーとして動かす）。fork 独自。
# システム側の yuuka.service から Requires= で参照するため、こちらもシステム側に置く
# （システムのユニットはユーザー側のユニットに依存できない）。
#   USER と /home/USER/yuuka を書き換えて置く:
#   sudo cp deploy/systemd/system/yuuka-redis.service.example /etc/systemd/system/yuuka-redis.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now yuuka-redis.service
# 配布パッケージの redis-server.service（6379 番）とは同居できないので、そちらは止めておく。
[Unit]
Description=Yuuka Redis session store
After=network.target

[Service]
User=USER
Group=USER
ExecStart=/usr/bin/redis-server /home/USER/yuuka/deploy/prod/redis.conf
Restart=always
RestartSec=3

# ─── 資源の上限と隔離（何も書き込まない。読むのは redis.conf だけ） ───
MemoryMax=512M
ProtectHome=tmpfs
BindReadOnlyPaths=/home/USER/yuuka/deploy/prod/redis.conf
BindReadOnlyPaths=-/home/USER/.nix-profile -/home/USER/.local/state/nix
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
